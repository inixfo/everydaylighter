    {
      "parameters": {
        "jsonSchemaExample": "{\"headline\": \"Operations were healthy with three items needing attention.\", \"summary\": \"A concise deterministic-data summary.\", \"attention\": [\"1 overdue invoice\"], \"data_quality_note\": \"All five sources were available.\"}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2860,
        390
      ],
      "id": "39582844-d6f2-474a-85f3-44fcf8bfa8b4",
      "name": "Structured Summary Parser"
    },
    {
      "parameters": {
        "jsCode": "const k=$('Calculate Trusted KPIs').first().json; const raw=$input.first().json||{};\nlet s=raw.output||raw.text||raw; if(typeof s==='string'){try{s=JSON.parse(s)}catch(e){s={}}}\nconst valid=s && typeof s.headline==='string' && typeof s.summary==='string' && Array.isArray(s.attention);\nif(!valid){s={headline:`Daily business report — ${k.report_date}`,summary:`Trusted KPIs calculated. ${k.ecommerce.orders_paid} ecommerce order(s), ${k.invoices.paid} invoice payment(s), ${k.feedback.responses} feedback response(s).`,attention:k.anomalies,data_quality_note:k.source_coverage===100?'All configured sources available.':`Source coverage ${k.source_coverage}%. Review missing sources.`};}\nconst money=v=>`${k.currency} ${Number(v||0).toLocaleString('en-US',{maximumFractionDigits:2})}`;\nconst anomalyHtml=(s.attention?.length?s.attention:k.anomalies).map(x=>`<li>${String(x)}</li>`).join('')||'<li>No deterministic attention flags.</li>';\nconst html=`<div style=\"font-family:Arial,sans-serif;max-width:720px\"><h2>${s.headline}</h2><p>${s.summary}</p><h3>Today at a glance</h3><ul><li>New leads: ${k.sales.leads_new}</li><li>Deals won: ${k.sales.deals_won}</li><li>Ecommerce orders: ${k.ecommerce.orders_paid} — ${money(k.ecommerce.revenue)}</li><li>Cash collected: ${money(k.invoices.paid_total)}</li><li>Outstanding A/R: ${money(k.invoices.outstanding_ar)}</li><li>Feedback responses: ${k.feedback.responses}${k.feedback.avg_rating!==null?` — avg ${k.feedback.avg_rating}/5`:''}</li></ul><h3>Needs attention</h3><ul>${anomalyHtml}</ul><p><strong>Data quality:</strong> ${s.data_quality_note} Coverage ${k.source_coverage}%.</p></div>`;\nconst tg=`📊 Daily Business Report — ${k.report_date}\\nOrders: ${k.ecommerce.orders_paid} | Revenue: ${money(k.ecommerce.revenue)}\\nCash: ${money(k.invoices.paid_total)} | A/R: ${money(k.invoices.outstanding_ar)}\\nLeads: ${k.sales.leads_new} | Won: ${k.sales.deals_won}\\nAttention: ${(k.anomalies.length?k.anomalies.join('; '):'none')}\\nCoverage: ${k.source_coverage}%`;\nreturn [{json:{...k,summary:s,email_html:html,telegram_text:tg,final_status:k.source_coverage===100?'summarized':'degraded'}}];"
      },
