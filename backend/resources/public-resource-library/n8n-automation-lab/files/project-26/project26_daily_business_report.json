        "jsCode": "const now = new Date();\n// The workflow timezone controls Schedule Trigger. For the report contract we keep explicit ISO boundaries.\nconst end = new Date(now); end.setHours(0,0,0,0); end.setDate(end.getDate()+1);\nconst start = new Date(end); start.setDate(start.getDate()-1);\nconst reportDate = start.toISOString().slice(0,10);\nreturn [{json:{report_key:'BUSINESS:'+reportDate,report_date:reportDate,window_start:start.toISOString(),window_end:end.toISOString(),timezone:'REPLACE_WITH_BUSINESS_TIMEZONE',expected_sources:['sales','onboarding','invoices','feedback','ecommerce'],currency:'REPLACE_WITH_REPORTING_CURRENCY',generated_at:now.toISOString()}}];"
