    {
      "parameters": {
        "jsCode": "const w = $('Resolve Report Identity').first().json;\nconst start = new Date(w.window_start).getTime(); const end = new Date(w.window_end).getTime();\nconst rows = name => { try { return $(name).all().map(x=>x.json).filter(x=>Object.keys(x||{}).length); } catch(e) { return []; } };\nconst inside = v => { if(!v) return false; const t=new Date(v).getTime(); return Number.isFinite(t) && t>=start && t<end; };\nconst num = v => Number.isFinite(Number(v)) ? Number(v) : 0;\nconst salesRows=rows('Get Sales Snapshot').filter(r=>r.snapshot_date===w.report_date);\nconst ob=rows('Get Onboarding Rows'), inv=rows('Get Invoice Rows'), fb=rows('Get Feedback Rows'), ord=rows('Get Ecommerce Rows');\nconst sales={leads_new:salesRows.reduce((a,r)=>a+num(r.leads_new),0),leads_hot:salesRows.reduce((a,r)=>a+num(r.leads_hot),0),followups_due:salesRows.reduce((a,r)=>a+num(r.followups_due),0),deals_won:salesRows.reduce((a,r)=>a+num(r.deals_won),0),deals_lost:salesRows.reduce((a,r)=>a+num(r.deals_lost),0),won_value:salesRows.reduce((a,r)=>a+num(r.won_value),0),pipeline_open_value:salesRows.reduce((a,r)=>a+num(r.pipeline_open_value),0)};\nconst onboarding={new:ob.filter(r=>inside(r.created_at)).length,ready:ob.filter(r=>r.onboarding_status==='ready' && inside(r.updated_at)).length,review:ob.filter(r=>r.onboarding_status==='review').length,aging_over_sla:ob.filter(r=>!['ready'].includes(r.onboarding_status) && r.created_at && (end-new Date(r.created_at).getTime())>72*3600000).length};\nconst issuedToday=inv.filter(r=>inside(r.issued_at)); const paidToday=inv.filter(r=>inside(r.paid_at)); const unpaid=inv.filter(r=>r.status==='issued' && !r.paid_at);\nconst invoices={issued:issuedToday.length,issued_total:issuedToday.reduce((a,r)=>a+num(r.total),0),paid:paidToday.length,paid_total:paidToday.reduce((a,r)=>a+num(r.total),0),overdue_count:unpaid.filter(r=>r.due_date && new Date(r.due_date).getTime()<end).length,outstanding_ar:unpaid.reduce((a,r)=>a+num(r.total),0)};\nconst fbToday=fb.filter(r=>inside(r.responded_at)); const ratings=fbToday.map(r=>num(r.rating)).filter(v=>v>0);\nconst feedback={responses:fbToday.length,avg_rating:ratings.length?Number((ratings.reduce((a,b)=>a+b,0)/ratings.length).toFixed(2)):null,recovery_open:fb.filter(r=>r.recovery_status==='open').length,negative:fbToday.filter(r=>r.sentiment==='negative').length};\nconst ordToday=ord.filter(r=>inside(r.last_event_at||r.updated_at) && r.financial_status==='paid');\nconst ecommerce={orders_paid:ordToday.length,revenue:ordToday.reduce((a,r)=>a+num(r.total_price),0),review:ord.filter(r=>r.route==='review'||r.status==='review').length,cancelled:ord.filter(r=>inside(r.cancelled_at)).length};\nconst coverage={sales:salesRows.length>0,onboarding:true,invoices:true,feedback:true,ecommerce:true};\nconst source_coverage=Math.round(Object.values(coverage).filter(Boolean).length/Object.keys(coverage).length*100);\nconst anomalies=[];\nif(invoices.overdue_count>0) anomalies.push(`${invoices.overdue_count} overdue invoice(s)`);\nif(onboarding.aging_over_sla>0) anomalies.push(`${onboarding.aging_over_sla} onboarding(s) over 72h`);\nif(feedback.recovery_open>0) anomalies.push(`${feedback.recovery_open} open feedback recovery case(s)`);\nif(ecommerce.review>0) anomalies.push(`${ecommerce.review} ecommerce order(s) need review`);\nif(!coverage.sales) anomalies.push('Sales snapshot unavailable for this date');\nconst kpi={report_key:w.report_key,report_date:w.report_date,timezone:w.timezone,currency:w.currency,source_coverage,sales,onboarding,invoices,feedback,ecommerce,anomalies,status:source_coverage===100?'calculated':'degraded',generated_at:w.generated_at};\nreturn [{json:kpi}];"
      },
