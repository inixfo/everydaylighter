      "parameters": {
        "jsCode": "const x = $json;\nconst nextStep = x.kickoff_link ? `Kickoff / next step: ${x.kickoff_link}` : 'Next step: reply with any missing project information and we will confirm the kickoff plan.';\nconst subject = `Welcome — ${x.project_name}`;\nconst body = `Hi ${x.client_name},\\n\\nWelcome! We’re ready to start ${x.project_name}.\\n\\nProject workspace: ${x.folder_url}\\n\\nPlease use this folder for approved project files and assets. Do not send passwords, API keys, card details, or other secrets by email.\\n\\n${nextStep}\\n\\nIf the scope or contact details changed, reply before uploading sensitive business material.\\n\\nThanks!`;\nreturn [{json:{...x,welcome_subject:subject,welcome_body:body}}];"
