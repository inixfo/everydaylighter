        "jsCode": "const incoming = $('Prepare Onboarding Contract').item.json;\nconst state = $json || {};\nconst folderId = String(state.folder_id ?? '').trim();\nconst welcomed = String(state.welcome_sent ?? '').toLowerCase() === 'yes';\nreturn [{json:{\n  ...incoming,\n  existing_state_found: Boolean(state.onboarding_key),\n  folder_id: folderId,\n  folder_url: String(state.folder_url ?? ''),\n  onboarding_status: String(state.onboarding_status ?? 'received'),\n  welcome_sent: welcomed ? 'yes' : 'no',\n  need_folder: !folderId,\n  need_welcome: !welcomed\n}}];"
