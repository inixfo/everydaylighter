    {
      "parameters": {
        "jsCode": "const x = $json;\nconst clean = (v) => String(v ?? '').trim();\nconst safeName = (v) => clean(v).replace(/[\\\\/:*?\"<>|#%{}~]/g, '-').replace(/\\s+/g,' ').slice(0,90);\nconst email = clean(x.client_email).toLowerCase();\nconst required = {\n  deal_id: clean(x.deal_id),\n  client_name: clean(x.client_name),\n  client_email: email,\n  service: clean(x.service),\n  project_name: clean(x.project_name || `${x.client_name || 'Client'} - ${x.service || 'Project'}`),\n};\nconst missing = Object.entries(required).filter(([k,v]) => !v).map(([k])=>k);\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nif (email && !emailOk) missing.push('client_email_invalid');\nconst onboardingKey = required.deal_id || `email:${email}:${required.service}`;\nreturn [{json:{\n  ...x,\n  ...required,\n  client_email: email,\n  owner_email: clean(x.owner_email),\n  amount: clean(x.amount),\n  kickoff_link: clean(x.kickoff_link),\n  source: clean(x.source || 'unknown'),\n  onboarding_key: onboardingKey,\n  folder_name: safeName(`${required.client_name} — ${required.project_name}`),\n  is_valid: missing.length === 0,\n  missing_fields: missing,\n  received_at: new Date().toISOString()\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
