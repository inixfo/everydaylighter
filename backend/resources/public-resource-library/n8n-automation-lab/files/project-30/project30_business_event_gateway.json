        "jsCode": "const raw=$input.first().json||{}; const body=raw.body&&typeof raw.body==='object'?raw.body:raw; let data=body.data||{}; if(typeof data==='string'){try{data=JSON.parse(data)}catch{data={raw:data}}} const required=['event_id','event_type','entity_type','entity_id']; const missing=required.filter(k=>!String(body[k]||'').trim()); if(missing.length) throw new Error('missing_event_fields:'+missing.join(',')); const now=new Date().toISOString(); return [{json:{event_id:String(body.event_id).trim(),trace_id:String(body.trace_id||body.event_id).trim(),event_type:String(body.event_type).trim().toLowerCase(),schema_version:String(body.schema_version||'business.event.v1'),source:String(body.source||'unknown'),entity_type:String(body.entity_type).trim(),entity_id:String(body.entity_id).trim(),occurred_at:String(body.occurred_at||now),received_at:now,data,raw_event_json:JSON.stringify({...body,data})}}];"
