{
  "name": "PROJECT 05 — Save Gmail Attachments to Google Drive",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "has:attachment",
          "readStatus": "unread"
        },
        "options": {
          "dataPropertyAttachmentsPrefixName": "attachment_",
          "downloadAttachments": true
        }
      },
      "id": "3a352ded-b2de-4912-a30f-650454659a72",
      "name": "Gmail Trigger — Attachments",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        -520,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (let i = 0; i < items.length; i++) {\n  const files = items[i].binary ?? {};\n  for (const [key, file] of Object.entries(files)) {\n    out.push({\n      json: {\n        ...items[i].json,\n        attachmentKey: key,\n        fileName: file.fileName || key,\n        mimeType: file.mimeType || '',\n        fileSize: file.fileSize || ''\n      },\n      binary: { data: file },\n      pairedItem: { item: i }\n    });\n  }\n}\nreturn out;"
      },
      "id": "0fc4a822-b9b6-45bc-a6af-cdf16f256256",
      "name": "Split Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "inputDataFieldName": "data",
        "name": "={{ $json.fileName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_FOLDER_ID"
        },
        "options": {}
      },
      "id": "40f593ae-4b60-48b3-a333-2883305ac0db",
      "name": "Upload Attachment to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        100,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_DRIVE_CREDENTIAL",
          "name": "Google Drive account"
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger — Attachments": {
      "main": [
        [
          {
            "node": "Split Attachments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Attachments": {
      "main": [
        [
          {
            "node": "Upload Attachment to Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
