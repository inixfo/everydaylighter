        },
        "options": {}
      },
      "id": "combine",
      "name": "Combine Draft Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j=$json;\nconst out=j.output ?? j;\nconst email=(j.recipient_email||'').trim();\nconst fact=(j.public_fact||'').trim();\nconst source=(j.fact_source_url||'').trim();\nconst body=(out.email_body||'').trim();\nconst subject=(out.subject_a||'').trim();\nconst opt=(out.opt_out_line||'').trim();\nconst words=body ? body.split(/\\s+/).filter(Boolean).length : 0;\nconst emailOk=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst reasons=[];\nif (!emailOk) reasons.push('Invalid recipient email');\nif (!fact || !source) reasons.push('Missing verified public fact/source');\nif (j.do_not_contact === true || String(j.do_not_contact).toLowerCase()==='true') reasons.push('DO_NOT_CONTACT');\nif (words < 45 || words > 150) reasons.push(`Body length ${words} words`);\nif (!subject || subject.length > 70) reasons.push('Subject missing or over 70 characters');\nif (!out.cta) reasons.push('Missing CTA');\nif (!opt) reasons.push('Missing opt-out line');\nif (out.claims_grounded === false) reasons.push('AI marked claims ungrounded');\nif (out.needs_human_review === true) reasons.push(out.review_reason || 'AI requested review');\nconst review = reasons.length > 0;\nconst finalBody=[out.opening_line, body, out.cta, opt].filter(Boolean).join('\\n\\n');\nreturn [{json:{...j,...out,word_count:words,quality_passed:!review,final_status:review?'NEEDS_REVIEW':'DRAFTED',qa_reasons:reasons,final_message:finalBody,generated_at:new Date().toISOString()}}];"
      },
      "id": "qa",
      "name": "Quality Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        0
      ]
    },
