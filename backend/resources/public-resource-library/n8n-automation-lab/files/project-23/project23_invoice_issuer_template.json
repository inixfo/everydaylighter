    {
      "parameters": {
        "jsCode": "const x = $json;\nconst clean = (v) => String(v ?? '').trim();\nconst email = clean(x.client_email).toLowerCase();\nlet items = x.line_items;\nif (!Array.isArray(items)) {\n  try { items = JSON.parse(clean(x.line_items_json || '[]')); } catch { items = []; }\n}\nitems = Array.isArray(items) ? items.map((r) => ({\n  description: clean(r.description),\n  quantity: Number(r.quantity ?? 0),\n  unit_price: Number(r.unit_price ?? 0)\n})) : [];\nconst required = {\n  invoice_key: clean(x.invoice_key), invoice_number: clean(x.invoice_number),\n  client_name: clean(x.client_name), client_email: email,\n  currency: clean(x.currency).toUpperCase(), due_date: clean(x.due_date)\n};\nconst missing = Object.entries(required).filter(([k,v]) => !v).map(([k])=>k);\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) missing.push('client_email_invalid');\nif (!items.length) missing.push('line_items');\nif (items.some(i => !i.description || !Number.isFinite(i.quantity) || i.quantity <= 0 || !Number.isFinite(i.unit_price) || i.unit_price < 0)) missing.push('line_items_invalid');\nconst due = new Date(required.due_date);\nif (Number.isNaN(due.getTime())) missing.push('due_date_invalid');\nreturn [{json:{...x,...required,client_email:email,line_items:items,discount_amount:Number(x.discount_amount||0),tax_rate:Number(x.tax_rate||0),issue_date:clean(x.issue_date || new Date().toISOString().slice(0,10)),payment_link:clean(x.payment_link),billing_address:clean(x.billing_address),notes:clean(x.notes),owner_email:clean(x.owner_email),source:clean(x.source||'approved_billing'),is_valid:missing.length===0,missing_fields:[...new Set(missing)],received_at:new Date().toISOString()}}];"
      },
