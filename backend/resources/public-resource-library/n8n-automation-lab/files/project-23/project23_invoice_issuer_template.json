        "jsCode": "const incoming = $('Prepare Billing Contract').item.json; const s=$json||{}; const status=String(s.status||'').toLowerCase(); const already=['document_ready','issued','paid','cancelled'].includes(status) && Boolean(s.doc_id); return [{json:{...incoming,existing_state_found:Boolean(s.invoice_key),existing_status:status,existing_doc_id:String(s.doc_id||''),existing_pdf_name:String(s.pdf_name||''),existing_total:Number(s.total||0),existing_issued_at:String(s.issued_at||''),already_created:already,already_issued:['issued','paid','cancelled'].includes(status)}}];"
      },
