    {
      "parameters": {
        "jsCode": "const x=$json; const round=(n)=>Math.round((Number(n)+Number.EPSILON)*100)/100; const lines=x.line_items.map((i,idx)=>({...i,line_total:round(i.quantity*i.unit_price),line_no:idx+1})); const subtotal=round(lines.reduce((a,i)=>a+i.line_total,0)); const discount=round(Math.max(0,Number(x.discount_amount||0))); const taxable=round(Math.max(0,subtotal-discount)); const rate=Number(x.tax_rate||0); if (!Number.isFinite(rate)||rate<0||rate>100) throw new Error('tax_rate must be between 0 and 100'); const tax=round(taxable*(rate/100)); const total=round(taxable+tax); const fmt=(n)=>`${x.currency} ${Number(n).toFixed(2)}`; const lineText=lines.map(i=>`${i.line_no}. ${i.description} — ${i.quantity} × ${fmt(i.unit_price)} = ${fmt(i.line_total)}`).join('\\n'); const fileSafe=String(x.invoice_number).replace(/[^a-zA-Z0-9._-]/g,'-'); return [{json:{...x,line_items:lines,line_items_text:lineText,subtotal,discount_amount:discount,tax_amount:tax,total,subtotal_text:fmt(subtotal),discount_text:fmt(discount),tax_amount_text:fmt(tax),total_text:fmt(total),tax_rate_text:`${rate.toFixed(2)}%`,pdf_name:`${fileSafe}.pdf`}}];"
      },
