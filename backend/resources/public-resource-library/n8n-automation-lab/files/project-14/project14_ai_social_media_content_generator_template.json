    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a social media copywriter. Create draft content ONLY from the approved facts below.\\n\\nRULES:\\n- Never invent product features, prices, discounts, deadlines, guarantees, statistics, testimonials, or availability.\\n- If a required fact is missing or the brief could create a misleading claim, set needs_review=true.\\n- Keep the core offer consistent across platforms, but adapt the writing style to each platform.\\n- Follow the requested language and brand voice.\\n- Facebook caption: clear, conversational, useful context, one CTA.\\n- Instagram caption: stronger opening hook, tighter body, scannable line breaks, one CTA.\\n- Hashtags must be relevant and specific; do not add random trending tags.\\n- visual_idea should be a simple production idea, not a promise that an image has been created.\\n\\nAPPROVED BRIEF:\\n{{ $json.content_brief }}\\n\\nReturn the required structured output.",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "chain",
      "name": "Generate Social Content",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
