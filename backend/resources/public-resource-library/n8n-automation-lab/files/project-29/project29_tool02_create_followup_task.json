        -540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$input.first().json||{}; const customer_id=String(x.customer_id||'').trim(); const title=String(x.title||'').trim().slice(0,180); const request_id=String(x.request_id||'').trim(); const priority=['low','normal','high'].includes(String(x.priority||'').toLowerCase())?String(x.priority).toLowerCase():'normal'; if(!customer_id) throw new Error('customer_id is required'); if(!title) throw new Error('title is required'); if(!request_id) throw new Error('request_id is required'); return [{json:{task_key:`agent-followup:${request_id}`,customer_id,title,due_at:String(x.due_at||''),priority,status:'open',created_by:'ai_agent',created_at:new Date().toISOString()}}];"
      },
      "id": "8c4a26c0-7949-4eb7-9d2a-39cf0611a96d",
      "name": "Prepare Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "value": "REPLACE_WITH_P29_TASK_TABLE_ID",
          "mode": "list",
          "cachedResultName": "p29_followup_tasks"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "task_key",
              "keyValue": "={{ $json.task_key }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "task_key": "={{ $json.task_key }}",
            "customer_id": "={{ $json.customer_id }}",
            "title": "={{ $json.title }}",
            "due_at": "={{ $json.due_at }}",
            "priority": "={{ $json.priority }}",
            "status": "={{ $json.status }}",
            "created_by": "={{ $json.created_by }}",
            "created_at": "={{ $json.created_at }}"
          }
        },
        "matchType": "allConditions"
      },
      "id": "0304e865-fe98-4192-a791-c31caf0e2c77",
      "name": "Upsert Follow-up Task",
