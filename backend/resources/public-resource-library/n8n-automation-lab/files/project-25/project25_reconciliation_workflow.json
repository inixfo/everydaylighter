      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "REPLACE_WITH_YOUR_SHOPIFY_CREDENTIAL",
          "name": "Shopify Access Token account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const shop='REPLACE_WITH_STORE_DOMAIN'; return $input.all().filter(i=>String(i.json.financial_status||'').toLowerCase()==='paid' && !i.json.cancelled_at).map(i=>({json:{order_key:shop+':'+String(i.json.id),order_id:String(i.json.id),order_name:String(i.json.name||i.json.id),updated_at:String(i.json.updated_at||new Date().toISOString())}}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ],
      "id": "d5eecd39-3886-473f-8019-04c589fc8234",
      "name": "Keep Paid Orders"
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "REPLACE_WITH_ORDER_STATE_TABLE_ID",
          "mode": "list",
          "cachedResultName": "order_state"
        },
        "returnAll": false,
        "filters": {
          "conditions": [
            {
              "keyName": "order_key",
              "keyValue": "={{ $json.order_key }}"
            }
          ]
        },
        "matchType": "allConditions"
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        150,
        0
      ],
      "id": "0922a6a8-0efa-4b47-b7bc-e9931131aa7e",
      "name": "Get Matching State",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const src=$('Keep Paid Orders').item.json; const found=Boolean($json&&$json.order_key); return [{json:{...src,missing_local_state:!found}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "id": "bf9ce448-7f9f-4d52-bfb6-95601f4becd2",
      "name": "Detect Missing State"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "m",
              "leftValue": "={{ $json.missing_local_state }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
