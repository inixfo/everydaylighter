        "jsCode": "const x=$json; const items=(x.line_items||[]).map(i=>({id:i.id,sku:String(i.sku||'').trim(),title:i.title,quantity:Number(i.quantity||0),requires_shipping:Boolean(i.requires_shipping)})); const shop=String($json.shop_domain||'REPLACE_WITH_STORE_DOMAIN'); const orderId=String(x.id||x.admin_graphql_api_id||''); const prefixes=items.map(i=>i.sku); const digital=items.some(i=>!i.requires_shipping || /^(DIGITAL-|PDF-|COURSE-)/i.test(i.sku)); const physical=items.some(i=>i.requires_shipping || /^(PHYS-|TEE-)/i.test(i.sku)); const unknown=items.some(i=>!i.sku); let route=unknown?'review':(digital&&physical?'mixed':digital?'digital':physical?'physical':'review'); const name=(x.customer?.first_name||x.shipping_address?.first_name||'')+' '+(x.customer?.last_name||x.shipping_address?.last_name||''); return [{json:{order_key:shop+':'+orderId,shop_domain:shop,order_id:orderId,order_name:String(x.name||x.order_number||orderId),financial_status:String(x.financial_status||'paid'),currency:String(x.currency||''),total_price:Number(x.current_total_price||x.total_price||0),customer_name:name.trim()||'Customer',customer_email:String(x.email||x.contact_email||'').toLowerCase(),route,status:'paid',line_items:items,line_items_json:JSON.stringify(items),items_summary:items.map(i=>`${i.sku||'(no sku)'} x${i.quantity}`).join(', '),last_event_at:String(x.updated_at||x.created_at||new Date().toISOString()),updated_at:new Date().toISOString()}}];"
      },
