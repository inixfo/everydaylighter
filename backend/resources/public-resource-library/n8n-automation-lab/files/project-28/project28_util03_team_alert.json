    {
      "parameters": {
        "jsCode": "const x=$input.first().json||{}; const allowed=['info','warning','critical']; const severity=allowed.includes(String(x.severity||'').toLowerCase())?String(x.severity).toLowerCase():'info'; const title=String(x.title||'Automation event').trim().slice(0,120); const message=String(x.message||'').trim().slice(0,1500); const event_key=String(x.event_key||'').trim(); if(!event_key) throw new Error('event_key is required'); return [{json:{event_key,severity,title,message,workflow_name:String(x.workflow_name||''),execution_url:String(x.execution_url||''),alert_text:`${severity==='critical'?'🚨':severity==='warning'?'⚠️':'ℹ️'} ${title}\\n${message}\\nWorkflow: ${String(x.workflow_name||'n/a')}\\n${String(x.execution_url||'')}`}}];"
      },
      "id": "0e7bd495-a080-450c-a29b-cb076109465c",
      "name": "Prepare Safe Alert",
