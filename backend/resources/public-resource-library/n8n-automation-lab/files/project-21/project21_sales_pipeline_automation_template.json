    {
      "parameters": {
        "jsCode": "// IMPORTANT: Replace these placeholders with the INTERNAL stage IDs from your HubSpot account.\nconst STAGES = {\n  'REPLACE_STAGE_ID_NEW':          {key:'NEW',            dueHours:null, subject:'Review new opportunity'},\n  'REPLACE_STAGE_ID_QUALIFIED':    {key:'QUALIFIED',      dueHours:1,    subject:'Contact qualified opportunity'},\n  'REPLACE_STAGE_ID_DISCOVERY':    {key:'DISCOVERY',      dueHours:24,   subject:'Prepare discovery next step'},\n  'REPLACE_STAGE_ID_PROPOSAL':     {key:'PROPOSAL_SENT',  dueHours:48,   subject:'Follow up on proposal'},\n  'REPLACE_STAGE_ID_NEGOTIATION':  {key:'NEGOTIATION',    dueHours:1,    subject:'Prioritize negotiation next step'},\n  'REPLACE_STAGE_ID_WON':          {key:'CLOSED_WON',     dueHours:null, subject:'Handoff won deal'},\n  'REPLACE_STAGE_ID_LOST':         {key:'CLOSED_LOST',    dueHours:24,   subject:'Record closed-lost reason'}\n};\nconst cfg = STAGES[String($json.current_stage_id)] || {key:'UNMAPPED',dueHours:null,subject:'Review unmapped pipeline stage'};\nconst due = cfg.dueHours == null ? '' : new Date(Date.now()+cfg.dueHours*3600*1000).toISOString();\nreturn [{json:{...$json,stage_key:cfg.key,task_due_at:due,task_subject:cfg.subject}}];"
      },
