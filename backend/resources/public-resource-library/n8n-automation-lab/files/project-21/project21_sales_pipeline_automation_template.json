    {
      "parameters": {
        "jsCode": "const e = $json;\nconst dealId = String(e.dealId ?? e.objectId ?? '');\nconst stageId = String(e.propertyValue ?? '');\nconst occurredAt = Number(e.occurredAt ?? Date.now());\nconst eventKey = [e.portalId ?? 'portal', dealId, e.propertyName ?? 'dealstage', stageId, occurredAt].join(':');\nreturn [{json:{...e,deal_id:dealId,event_stage_id:stageId,occurred_at:occurredAt,event_key:eventKey}}];"
      },
      "id": "normalize",
      "name": "Normalize Stage Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.event_key }}",
        "options": {}
      },
      "id": "dedupe",
      "name": "Deduplicate Exact Event",
      "type": "n8n-nodes-base.removeDuplicates",
