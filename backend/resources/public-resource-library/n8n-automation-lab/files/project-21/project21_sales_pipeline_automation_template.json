      "id": "getdeal",
      "name": "Get Current Deal",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        -410,
        0
      ],
      "credentials": {
        "hubspotAppToken": {
          "id": "REPLACE_WITH_HUBSPOT_APP_TOKEN",
          "name": "HubSpot Service Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const e = $('Normalize Stage Event').item.json;\nconst d = $json;\nconst p = d.properties || {};\nconst value = (key) => {\n  const v = p[key];\n  if (v && typeof v === 'object' && Object.prototype.hasOwnProperty.call(v,'value')) return v.value ?? '';\n  return v ?? d[key] ?? '';\n};\nreturn [{json:{\n  ...e,\n  deal_id: String(e.deal_id),\n  deal_name: String(value('dealname') || `Deal ${e.deal_id}`),\n  current_stage_id: String(value('dealstage') || ''),\n  pipeline_id: String(value('pipeline') || ''),\n  amount: String(value('amount') || ''),\n  close_date: String(value('closedate') || ''),\n  owner_id: String(value('hubspot_owner_id') || ''),\n  current_matches_event: String(value('dealstage') || '') === String(e.event_stage_id)\n}}];"
      },
      "id": "combine",
      "name": "Compare Event vs Current Deal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -170,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "current",
              "leftValue": "={{ $json.current_matches_event }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
