    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ $json.latitude }}"
            },
            {
              "name": "longitude",
              "value": "={{ $json.longitude }}"
            },
            {
              "name": "current",
              "value": "temperature_2m,apparent_temperature,weather_code"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code"
            },
            {
              "name": "timezone",
              "value": "={{ $json.timezone }}"
            },
            {
              "name": "forecast_days",
              "value": "1"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        0
      ],
      "id": "7c1a7444-8cbd-40ba-9f4f-88393f3d6b45",
      "name": "Get Weather Forecast"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Location Config').first().json;\nconst d = $json;\nconst code = d.current?.weather_code ?? d.daily?.weather_code?.[0];\nfunction label(c){\n  if (c === 0) return 'Clear sky';\n  if ([1,2,3].includes(c)) return 'Mainly clear / cloudy';\n  if ([45,48].includes(c)) return 'Fog';\n  if ([51,53,55,56,57].includes(c)) return 'Drizzle';\n  if ([61,63,65,66,67].includes(c)) return 'Rain';\n  if ([71,73,75,77,85,86].includes(c)) return 'Snow';\n  if ([80,81,82].includes(c)) return 'Rain showers';\n  if ([95,96,99].includes(c)) return 'Thunderstorm';\n  return 'Weather code ' + c;\n}\nconst rain = Number(d.daily?.precipitation_probability_max?.[0] ?? 0);\nconst out = {\n  city: cfg.city,\n  current_temp: d.current?.temperature_2m,\n  feels_like: d.current?.apparent_temperature,\n  weather_code: code,\n  condition: label(code),\n  max_temp: d.daily?.temperature_2m_max?.[0],\n  min_temp: d.daily?.temperature_2m_min?.[0],\n  rain_probability: rain,\n  rain_threshold: Number(cfg.rain_threshold ?? 60)\n};\nout.is_rain_alert = out.rain_probability >= out.rain_threshold;\nout.normal_message = `☀ Daily Weather — ${out.city}\\n\\n${out.condition}\\nNow: ${out.current_temp}°C • Feels ${out.feels_like}°C\\nToday: ${out.min_temp}°–${out.max_temp}°C\\nRain chance: ${out.rain_probability}%`;\nout.rain_message = `🌧 Rain Alert — ${out.city}\\n\\nRain chance: ${out.rain_probability}%\\n${out.condition}\\nNow: ${out.current_temp}°C • Feels ${out.feels_like}°C\\nToday: ${out.min_temp}°–${out.max_temp}°C\\n\\n☔ বাইরে গেলে ছাতা সঙ্গে রাখুন।`;\nreturn [{ json: out }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ],
      "id": "aa4d8c5d-ec7a-4d3b-af99-dd5bd082ce03",
      "name": "Prepare Weather"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "4ef0134d-c154-4e6d-867b-6a481e252337",
              "leftValue": "={{ $json.rain_probability }}",
              "rightValue": "={{ $json.rain_threshold }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
