        0
      ]
    },
    {
      "parameters": {
        "inputText": "={{ $json.email_text }}",
        "categories": {
          "categories": [
            {
              "category": "Sales",
              "description": "Potential customer asking about price, quote, demo, service, proposal, buying, onboarding, or becoming a customer."
            },
            {
              "category": "Support",
              "description": "Existing user or customer asking for help with a problem, bug, access issue, failed workflow, troubleshooting, or account/service issue."
            },
            {
              "category": "Invoice",
              "description": "Billing, invoice, receipt, payment, refund, due date, bank transfer, or accounting related email."
            },
            {
              "category": "Important",
              "description": "Urgent human attention: security warning, legal deadline, critical incident, account compromise, or explicitly time-sensitive high-priority request."
            },
            {
              "category": "Review",
              "description": "Newsletter, promotion, marketing blast, automated announcement, low-priority bulk message, or likely spam. Do not delete automatically."
            },
            {
              "category": "Other",
              "description": "Email that does not clearly fit the other categories, including general conversation or informational messages."
            }
          ]
        },
        "options": {}
      },
