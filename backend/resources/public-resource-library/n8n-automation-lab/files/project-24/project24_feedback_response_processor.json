        "jsCode": "const r=$('Normalize Feedback').item.json; const s=$json||{}; const exists=Boolean(s.feedback_key); const duplicate=String(s.responded||'no')==='yes'; return [{json:{...s,...r,key_valid:exists,already_responded:duplicate,customer_name:String(s.customer_name||''),customer_email:String(s.customer_email||''),context_name:String(s.context_name||''),owner_email:String(s.owner_email||''),review_policy:String(s.review_policy||'none'),review_url:String(s.review_url||'')}}];"
