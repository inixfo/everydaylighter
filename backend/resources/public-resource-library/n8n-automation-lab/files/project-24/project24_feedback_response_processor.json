    {
      "parameters": {
        "jsCode": "const x=$json; const q=x.formQueryParameters||{}; const c=v=>String(v??'').trim(); const rating=Number(x.Rating||x.rating||0); const feedback_key=c(q.feedback_key||x.feedback_key); const area=c(x.Area||x.area); const experience=c(x.Experience||x.experience); const improve=c(x.Improve||x.improve); const contact_back=/^yes$/i.test(c(x['Would you like a reply?']||x.contact_back))?'yes':'no'; const errors=[]; if(!feedback_key) errors.push('feedback_key_missing'); if(!Number.isInteger(rating)||rating<1||rating>5) errors.push('rating_invalid'); if(!area) errors.push('area_missing'); if(!experience) errors.push('experience_missing'); const priority=(rating<=2)?'HIGH':((rating===3||contact_back==='yes')?'MEDIUM':'NORMAL'); return [{json:{feedback_key,rating,area,experience,improve,contact_back,priority,is_valid:errors.length===0,errors,responded_at:new Date().toISOString(),updated_at:new Date().toISOString()}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
