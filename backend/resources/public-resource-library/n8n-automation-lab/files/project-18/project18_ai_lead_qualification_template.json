      "id": "combine",
      "name": "Combine Qualification Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -80,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const clamp=(n,min,max)=>Math.max(min,Math.min(max,Number(n)||0));\nconst j=$json;\nconst fit=clamp(j.fit_score,0,30);\nconst intent=clamp(j.intent_score,0,25);\nconst urgency=clamp(j.urgency_score,0,20);\nconst budget=clamp(j.budget_score,0,15);\nconst completeness=clamp(j.completeness_score,0,10);\nconst total=Math.round(fit+intent+urgency+budget+completeness);\nconst confidence=clamp(j.confidence,0,1);\nlet tier='COLD';\nlet review=Boolean(j.needs_human_review) || confidence < 0.65;\nif (review) tier='REVIEW';\nelse if (total>=80) tier='HOT';\nelse if (total>=55) tier='WARM';\nreturn [{json:{...j,fit_score:fit,intent_score:intent,urgency_score:urgency,budget_score:budget,completeness_score:completeness,total_score:total,confidence,final_tier:tier,needs_human_review:review,scored_at:new Date().toISOString()}}];"
      },
