ADMIN_NOTIFICATION_EMAIL="${MAIL_FROM_ADDRESS}"
SUPPORT_EMAIL="support@everydaylighter.com"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com/v1
STRIPE_WEBSITE=everydaylighter.com
STRIPE_PAYMENT_METHOD_TYPES=card
STRIPE_AUTOMATIC_TAX=false
STRIPE_BILLING_ADDRESS_COLLECTION=auto
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PIPRAPAY_ENABLED=false
PIPRAPAY_BASE_URL=https://sandbox.piprapay.com
PIPRAPAY_API_KEY=
PIPRAPAY_CURRENCY=BDT
PIPRAPAY_WEBHOOK_URL="${APP_URL}/api/v1/payments/piprapay/webhook"
